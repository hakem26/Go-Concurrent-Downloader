.env
.env.*
*.key
*.pem
secrets.yml

# Logs and temp
*.log
tmp/
temp/
*.tmp

# Go modules / cache (optional local caches)
Godeps/
.gopath/
*.modcache

# JetBrains specific
.idea/*
!.idea/inspectionProfiles
!.idea/vcs.xml

# VSCode (اگر گذرا استفاده می‌کنی)
.vscode/

